# Bright Data API key (get from https://brightdata.com/cp/setting)
BRIGHTDATA_API_KEY=

# Collector ID — auto-populated by create-scraper.js, or paste manually
COLLECTOR_ID=

# Target URL to scrape
TARGET_URL=https://www.freejobalert.com/latest-notifications/

# Cron schedule (default: every 30 minutes)
CRON_SCHEDULE=*/30 * * * *

# Dashboard port
PORT=3000

# Auto-approve heals without manual gate (true for unattended demo)
AUTO_APPROVE=true
